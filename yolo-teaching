 shutil\nimport cv2\nimport numpy as np\nimport torch\nfrom ultralytics import YOLO\n\n# 检查模型文件是否存在\nmodel_path = '/kaggle/input/yolodetection/pytorch/default/1/yolo11n.pt'\nif not os.path.exists(model_path):\n    print(f\"模型文件 {model_path} 不存在，正在下载...\")\n    try:\n        torch.hub.download_url_to_file('https://github.com/ultralytics/ultralytics/releases/download/v0.0.0/yolov11n.pt', model_path)\n        print(\"下载完成。\")\n    except Exception as e:\n        print(f\"下载失败，错误信息：{e}\")\n        print(\"请检查链接的合法性或在网络环境较好的情况下重试。\")\nelse:\n    print(f\"模型文件 {model_path} 已存在，可以继续。\")\n\n# 加载 YOLOv11n 模型\nmodel = YOLO(model_path)\n\n# 使用自己采集的视频进行测试\ndataset_video_path = '/kaggle/input/auto-test/auto_test_1.mp4'\n\n# 定义目标路径在工作目录中\nvideo_path = '/kaggle/working/sample_video.mp4'\n\n# 将视频文件从原始位置复制到 Kaggle 的当前工作目录中以便进一步处理\nshutil.copyfile(dataset_video_path, video_path)\n\n# 定义车道线检测函数\ndef detect_lanes(frame):\n    # 转换为灰度图像\n    gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n    # 使用高斯模糊去除噪声\n    blurred = cv2.GaussianBlur(gray, (5, 5), 0)\n    # 使用Canny边缘检测\n    edges = cv2.Canny(blurred, 50, 150)\n    # 定义ROI区域（假设车道线在图像下半部分）\n    height, width = edges.shape\n    mask = np.zeros_like(edges)\n    polygon = np.array([[\n        (0, height),\n        (width // 2, height // 2),\n        (width, height)\n    ]], np.int32)\n    cv2.fillPoly(mask, [polygon], 255)\n    masked_edges = cv2.bitwise_and(edges, mask)\n    # 使用霍夫变换检测直线\n    lines = cv2.HoughLinesP(masked_edges, 2, np.pi / 180, threshold=15, minLineLength=40, maxLineGap=5)\n    if lines is not None:\n        for line in lines:\n            x1, y1, x2, y2 = line[0]\n            cv2.line(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)\n    return frame\n\n# 使用 YOLOv11n 模型对样本视频进行车辆检测并保存输出\ncap = cv2.VideoCapture(video_path)\nfourcc = cv2.VideoWriter_fourcc(*'mp4v')\nout = cv2.VideoWriter('/kaggle/working/output_video.mp4', fourcc, 20.0, (int(cap.get(3)), int(cap.get(4))))\n\nwhile cap.isOpened():\n    ret, frame = cap.read()\n    if not ret:\n        break\n    \n    # 使用YOLO模型进行车辆检测\n    results = model(frame)\n    print(type(results))  # 查看返回值类型\n    print(results)        # 查看返回值内容\n\n    # 假设 results 是一个包含检测结果的列表\n    if isinstance(results, list):\n        for result in results:\n            # 假设每个 result 是一个字典，包含检测框信息\n            if 'box' in result:\n                x1, y1, x2, y2 = result['box']\n                cv2.rectangle(frame, (x1, y1), (x2, y2), (0, 255, 0), 2)\n    \n    # 检测车道线\n    lane_detected_frame = detect_lanes(frame)\n    \n    # 写入输出视频\n    out.write(lane_detected_frame)\n\ncap.release()\nout.release()\nprint(\"视频处理完成，结果已保存到 /kaggle/working/output_video.mp4\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-09T13:47:58.169820Z","iopub.execute_input":"2025-04-09T13:47:58.170195Z"}},"outputs":[{"name":"stdout","text":"模型文件 /kaggle/input/yolodetection/pytorch/default/1/yolo11n.pt 已存在，可以继续。\n\n0: 384x640 3 cars, 1 truck, 12.0ms\nSpeed: 2.1ms preprocess, 12.0ms inference, 1.6ms postprocess per image at shape (1, 3, 384, 640)\n<class 'list'>\n[ultralytics.engine.results.Results object with attributes:\n\nboxes: ultralytics.engine.results.Boxes object\nkeypoints: None\nmasks: None\nnames: {0: 'person', 1: 'bicycle', 2: 'car', 3: 'motorcycle', 4: 'airplane', 5: 'bus', 6: 'train', 7: 'truck', 8: 'boat', 9: 'traffic light', 10: 'fire hydrant', 11: 'stop sign', 12: 'parking meter', 13: 'bench', 14: 'bird', 15: 'cat', 16: 'dog', 17: 'horse', 18: 'sheep', 19: 'cow', 20: 'elephant', 21: 'bear', 22: 'zebra', 23: 'giraffe', 24: 'backpack', 25: 'umbrella', 26: 'handbag', 27: 'tie', 28: 'suitcase', 29: 'frisbee', 30: 'skis', 31: 'snowboard', 32: 'sports ball', 33: 'kite', 34: 'baseball bat', 35: 'baseball glove', 36: 'skateboard', 37: 'surfboard', 38: 'tennis racket', 39: 'bottle', 40: 'wine glass', 41: 'cup', 42: 'fork', 43: 'knife', 44: 'spoon', 45: 'bowl', 46: 'banana', 47: 'apple', 48: 'sandwich', 49: 'orange', 50: 'broccoli', 51: 'carrot', 52: 'hot dog', 53
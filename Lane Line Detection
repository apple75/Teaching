data":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-17T03:09:18.335165Z","iopub.execute_input":"2025-04-17T03:09:18.335635Z","iopub.status.idle":"2025-04-17T03:09:18.341405Z","shell.execute_reply.started":"2025-04-17T03:09:18.335604Z","shell.execute_reply":"2025-04-17T03:09:18.340506Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import cv2\nimport numpy as np\nfrom IPython.display import HTML\n\ndef preprocess_image(img):\n    gray_img = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    blurred_img = cv2.GaussianBlur(gray_img, (5, 5), 0)\n    canny_img = cv2.Canny(blurred_img, 180, 240)\n    return canny_img\n\ndef lane_finding_pipeline(image):\n    canny_img = preprocess_image(image)\n    vertices = get_vertices(image)\n    masked_img = region_of_interest(canny_img, vertices)\n    houghed_lines = hough_lines(masked_img, rho=1, theta=np.pi/180, threshold=20, min_line_len=20, max_line_gap=180)\n    output = weighted_img(houghed_lines, image, α=0.8, β=1., γ=0.)\n    return output\n\ndef process_image(img):\n    img_size = (img.shape[1], img.shape[0])\n    src = np.float32([[585, 460], [203, 720], [1127, 720], [695, 460]])\n    dst = np.float32([[320, 0], [320, 720], [960, 720], [960, 0]])\n    warped, M, Minv = warp_perspective(img, src, dst)\n    binary_warped = threshold_binary(warped)\n    out_img, left_fit, right_fit = fit_polynomial(binary_warped)\n    result = draw_lane(img, binary_warped, left_fit, right_fit, Minv)\n    return result\n\ndef detect_lane_lines(image):\n    # 尝试直道检测\n    straight_lane_result = lane_finding_pipeline(image)\n    \n    # 检查直道检测结果是否有效\n    if np.sum(straight_lane_result) > 0 and is_straight(straight_lane_result):\n        return straight_lane_result\n    \n    # 如果直道检测失败或检测到弯道，尝试弯道检测\n    curved_lane_result = process_image(image)\n    return curved_lane_result\n\ndef is_straight(image):\n    # 简单的逻辑来检查是否为直道\n    # 这里可以添加更复杂的逻辑，例如检查车道线的曲率\n    return np.std(image) < 50  # 假设直道的像素变化较小\n\ndef warp_perspective(img, src_pts, dst_pts):\n    src_pts = np.float32(src_pts)\n    dst_pts = np.float32(dst_pts)\n    M = cv2.getPerspectiveTransform(src_pts, dst_pts)\n    Minv = cv2.getPerspectiveTransform(dst_pts, src_pts)\n    warped = cv2.warpPerspective(img, M, (img.shape[1], img.shape[0]), flags=cv2.INTER_LINEAR)\n    return warped, M, Minv\n\ndef threshold_binary(img):\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 160, 255, cv2.THRESH_BINARY)\n    return binary\n\ndef find_lane_pixels(binary_warped):\n    histogram = np.sum(binary_warped[binary_warped.shape[0]//2:, :], axis=0)\n    out_img = np.dstack((binary_warped, binary_warped, binary_warped)) * 255\n    midpoint = int(histogram.shape[0] // 2)\n    leftx_base = np.argmax(histogram[:midpoint])\n    rightx_base = np.argmax(histogram[midpoint:]) + midpoint\n    nwindows = 15\n    margin = 50\n    minpix = 50\n    window_height = int(binary_warped.shape[0] // nwindows)\n    nonzero = binary_warped.nonzero()\n    nonzeroy = np.array(nonzero[0])\n    nonzerox = np.array(nonzero[1])\n    leftx_current = leftx_base\n    rightx_current = rightx_base\n    left_lane_inds = []\n    right_lane_inds = []\n    for window in range(nwindows):\n        win_y_low = binary_warped.shape[0] - (window + 1) * window_height\n        win_y_high = binary_warped.shape[0] - window * window_height\n        win_xleft_low = leftx_current - margin\n        win_xleft_high = leftx_current + margin\n        win_xright_low = rightx_current - margin\n        win_xright_high = rightx_current + margin\n        good_left_inds = ((nonzeroy >= win_y_low) & (nonzeroy < win_y_high) &\n                          (nonzerox >= win_xleft_low) & (nonzerox < win_xleft_high)).nonzero()[0]\n        good_right_inds = ((nonzeroy >= win_y_low) & (nonzeroy < win_y_high) &\n                           (nonzerox >= win_xright_low) & (nonzerox < win_xright_high)).nonzero()[0]\n        left_lane_inds.append(good_left_inds)\n        right_lane_inds.append(good_right_inds)\n        if len(good_left_inds) > minpix:\n            leftx_current = int(np.mean(nonzerox[good_left_inds]))\n        if len(good_right_inds) > minpix:\n            rightx_current = int(np.mean(nonzerox[good_right_inds]))\n    left_lane_inds = np.concatenate(left_lane_inds)\n    right_lane_inds = np.concatenate(right_lane_inds)\n    leftx = nonzerox[left_lane_inds]\n    lefty = nonzeroy[left_lane_inds]\n    rightx = nonzerox[right_lane_inds]\n    righty = nonzeroy[right_lane_inds]\n    return leftx, lefty, rightx, righty, nonzeroy, nonzerox, out_img, left_lane_inds, right_lane_inds\n\ndef fit_polynomial(binary_warped):\n    leftx, lefty, rightx, righty, nonzeroy, nonzerox, out_img, left_lane_inds, right_lane_inds = find_lane_pixels(binary_warped)\n    if len(leftx) == 0 or len(rightx) == 0:\n        return out_img, None, None\n    left_fit = np.polyfit(lefty, leftx, 5)\n    right_fit = np.polyfit(righty, rightx, 5)\n    ploty = np.linspace(0, binary_warped.shape[0] - 1, binary_warped.shape[0])\n    left_fitx = left_fit[0]*ploty**5 + left_fit[1]*ploty**4 + left_fit[2]*ploty**3 + left_fit[3]*ploty**2 + left_fit[4]*ploty + left_fit[5]\n    right_fitx = right_fit[0]*ploty**5 + right_fit[1]*ploty**4 + right_fit[2]*ploty**3 + right_fit[3]*ploty**2 + right_fit[4]*ploty + right_fit[5]\n    out_img[nonzeroy[left_lane_inds], nonzerox[left_lane_inds]] = [255, 0, 0]\n    out_img[nonzeroy[right_lane_inds], nonzerox[right_lane_inds]] = [0, 0, 255]\n    return out_img, left_fit, right_fit\n\ndef draw_lane(original_img, binary_warped, left_fit, right_fit, Minv):\n    ploty = np.linspace(0, binary_warped.shape[0] - 1, binary_warped.shape[0])\n    color_warp = np.zeros_like(original_img).astype(np.uint8)\n    if left_fit is None or right_fit is None:\n        return original_img\n    left_fitx = left_fit[0]*ploty**5 + left_fit[1]*ploty**4 + left_fit[2]*ploty**3 + left_fit[3]*ploty**2 + left_fit[4]*ploty + left_fit[5]\n    right_fitx = right_fit[0]*ploty**5 + right_fit[1]*ploty**4 + right_fit[2]*ploty**3 + right_fit[3]*ploty**2 + right_fit[4]*ploty + right_fit[5]\n    pts_left = np.array([np.transpose(np.vstack([left_fitx, ploty]))])\n    pts_right = np.array([np.flipud(np.transpose(np.vstack([right_fitx, ploty])))])\n    pts = np.hstack((pts_left, pts_right))\n    cv2.fillPoly(color_warp, np.int_([pts]), (0, 255, 0))\n    newwarp = cv2.warpPerspective(color_warp, Minv, (original_img.shape[1], original_img.shape[0]))\n    result = cv2.addWeighted(original_img, 1, newwarp, 0.3, 0)\n    return result\n\ndef get_vertices(image):\n    rows, cols = image.shape[:2]\n    bottom_left = [cols*0.15, rows]\n    top_left = [cols*0.45, rows*0.6]\n    bottom_right = [cols*0.95, rows]\n    top_right = [cols*0.55, rows*0.6]\n    ver = np.array([[bottom_left, top_left, top_right, bottom_right]], dtype=np.int32)\n    return ver\n\ndef hough_lines(img, rho, theta, threshold, min_line_len, max_line_gap):\n    lines = cv2.HoughLinesP(img, rho, theta, threshold, np.array([]), \n                            minLineLength=min_line_len, maxLineGap=max_line_gap)\n    line_img = np.zeros((img.shape[0], img.shape[1], 3), dtype=np.uint8)\n    if lines is not None and len(lines) > 0:\n        line_img = slope_lines(line_img, lines)\n    return line_img\n\ndef weighted_img(img, initial_img, α=0.1, β=1., γ=0.):\n    lines_edges = cv2.addWeighted(initial_img, α, img, β, γ)\n    return lines_edges\n\ndef region_of_interest(img, vertices):\n    mask = np.zeros_like(img)\n    if len(img.shape) > 2:\n        channel_count = img.shape[2]\n        ignore_mask_color = (255,) * channel_count\n    else:\n        ignore_mask_color = 255\n    cv2.fillPoly(mask, vertices, ignore_mask_color)\n    masked_image = cv2.bitwise_and(img, mask)\n    return masked_image\n\ndef slope_lines(image, lines):\n    img = image.copy()\n    poly_vertices = []\n    order = [0, 1, 3, 2]\n    left_lines = []\n    right_lines = []\n    \n    if lines is not None:\n        for line in lines:\n            for x1, y1, x2, y2 in line:\n                if x1 == x2:\n                    continue\n                else:\n                    m = (y2 - y1) / (x2 - x1)\n                    c = y1 - m * x1\n                    if m < 0:\n                        left_lines.append((m, c))\n                    elif m >= 0:\n                        right_lines.append((m, c))\n    \n    if len(left_lines) > 0:\n        left_line = np.mean(left_lines, axis=0)\n    else:\n        left_line = None\n        \n    if len(right_lines) > 0:\n        right_line = np.mean(right_lines, axis=0)\n    else:\n        right_line = None\n\n    valid_lines = []\n    if left_line is not None:\n        valid_lines.append(left_line)\n    if right_line is not None:\n        valid_lines.append(right_line)\n\n    for slope, intercept in valid_lines:\n        rows, cols = image.shape[:2]\n        y1 = int(rows)\n        y2 = int(rows * 0.6)\n        try:\n            x1 = int((y1 - intercept) / slope)\n            x2 = int((y2 - intercept) / slope)\n            poly_vertices.append((x1, y1))\n            poly_vertices.append((x2, y2))\n            draw_lines(img, np.array([[[x1, y1, x2, y2]]]))\n        except:\n            continue\n    \n    if len(poly_vertices) >= 4:\n        poly_vertices = [poly_vertices[i] for i in order]\n        cv2.fillPoly(img, pts=np.array([poly_vertices], 'int32'), color=(0, 255, 0))\n    \n    return cv2.addWeighted(image, 0.7, img, 0.4, 0.)\n\ndef draw_lines(img, lines, color=[255, 0, 0], thickness=10):\n    for line in lines:\n        for x1, y1, x2, y2 in line:\n            cv2.line(img, (x1, y1), (x2, y2), color, thickness)\n\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-17T03:36:36.475353Z","iopub.execute_input":"2025-04-17T03:36:36.475780Z","iopub.status.idle":"2025-04-17T03:36:36.514153Z","shell.execute_reply.started":"2025-04-17T03:36:36.475752Z","shell.execute_reply":"2025-04-17T03:36:36.513059Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"challenge_output = './challenge.mp4'\nclip2 = VideoFileClip('test_videos/challenge.mp4')   # 弯道测试\n#clip2 = VideoFileClip('test_videos/solidWhiteRight.mp4')  #直道测试\n\nyellow_clip = clip2.fl_image(detect_lane_lines)\n%time yellow_clip.write_videofile(challenge_output, audio=False)\n\nHTML(\"\"\"\n<video width=\"960\" height=\"500\" controls>\n  <source src=\"{0}\">\n</video>\n\"\"\".format(challenge_output))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-17T03:36:54.318167Z","iopub.execute_input":"2025-04-17T03:36:54.318573Z","iopub.status.idle":"2025-04-17T03:37:17.488015Z","shell.execute_reply.started":"2025-04-17T03:36:54.318545Z","shell.execute_reply":"2025-04-17T03:37:17.487059Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## **Shortcomings**  \n**1. Hough Transform is fit for Straight Lines only but in reality curved lane lines exists where this will fail.**   \n**2. There are many roads which don't have lane markings where this will fail.**","metadata":{}},{"cell_type":"markdown","source":"**References:**  \n1. [Udacity Self-Driving Car Nanodegree](https://www.udacity.com/course/self-driving-car-engineer-nanodegree--nd013)  \n2. [Finding Lane Lines — Simple Pipeline For Lane Detection](https://towardsdatascience.com/finding-lane-lines-simple-pipeline-for-lane-detection-d02b62e7572b)","metadata":{}}]}
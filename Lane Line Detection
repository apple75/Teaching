e":"2025-04-16T23:55:45.255222Z","shell.execute_reply.started":"2025-04-16T23:55:31.233893Z","shell.execute_reply":"2025-04-16T23:55:45.254173Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"### **Output**","metadata":{}},{"cell_type":"code","source":"HTML(\"\"\"\n<video width=\"960\" height=\"500\" controls>\n  <source src=\"{0}\">\n</video>\n\"\"\".format(yellow_output))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-16T23:55:45.256555Z","iopub.execute_input":"2025-04-16T23:55:45.257449Z","iopub.status.idle":"2025-04-16T23:55:45.263142Z","shell.execute_reply.started":"2025-04-16T23:55:45.257408Z","shell.execute_reply":"2025-04-16T23:55:45.262125Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"# 7. 实时车道线检测 + 目标车辆检测(yolo)","metadata":{}},{"cell_type":"code","source":"!pip install ultralytics","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-16T23:55:45.264230Z","iopub.execute_input":"2025-04-16T23:55:45.264587Z","iopub.status.idle":"2025-04-16T23:57:15.785417Z","shell.execute_reply.started":"2025-04-16T23:55:45.264555Z","shell.execute_reply":"2025-04-16T23:57:15.783166Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import cv2\nfrom ultralytics import YOLO\nfrom moviepy.editor import VideoFileClip\nimport numpy as np\n\n# 加载YOLOv8n模型\n# vehicle_model = YOLO('yolov8n.pt')  # 会自动下载预训练模型(如果本地没有)\nvehicle_model = YOLO('/kaggle/input/yolo11n/pytorch/default/1/yolo11n.pt')  # 会自动下载预训练模型(如果本地没有)\n\n\n\ndef combined_detection_pipeline(image):\n    # 原始车道线检测\n    lane_image = lane_finding_pipeline(image)\n    \n    # 将图像从RGB转换为BGR格式(因为OpenCV使用BGR)\n    img_bgr = cv2.cvtColor(np.array(image), cv2.COLOR_RGB2BGR)\n    \n    # 使用YOLOv8进行车辆检测\n    results = vehicle_model(img_bgr)\n    \n    # 只保留车辆类别的检测结果(根据COCO数据集，车辆类别包括car(2), truck(7), bus(5)等)\n    vehicle_classes = [2, 5, 7]\n    vehicle_detections = []\n    \n    for result in results:\n        for box in result.boxes:\n            class_id = int(box.cls)\n            if class_id in vehicle_classes:\n                # 获取边界框坐标\n                x1, y1, x2, y2 = map(int, box.xyxy[0])\n                # 获取置信度\n                conf = float(box.conf[0])\n                # 添加到检测结果列表\n                vehicle_detections.append((class_id, conf, (x1, y1, x2, y2)))\n    \n    # 在图像上绘制车辆检测框\n    for class_id, conf, (x1, y1, x2, y2) in vehicle_detections:\n        # 根据类别选择颜色\n        color = (0, 255, 0)  # 绿色框\n        if class_id == 5:  # 公交\n            color = (0, 165, 255)  # 橙色\n        elif class_id == 7:  # 卡车\n            color = (0, 0, 255)  # 红色\n            \n        # 绘制边界框\n        cv2.rectangle(lane_image, (x1, y1), (x2, y2), color, 2)\n        \n        # 添加标签和置信度\n        label = f\"{vehicle_model.names[class_id]}: {conf:.2f}\"\n        cv2.putText(lane_image, label, (x1, y1-10), \n                   cv2.FONT_HERSHEY_SIMPLEX, 0.5, color, 2)\n    \n    return lane_image\n\n# 输出文件路径\noutput_video = './output_video.mp4'\n\n# 加载视频文件\n#clip2 = VideoFileClip('test_videos/challenge.mp4')\nclip2 = VideoFileClip('/kaggle/input/auto-test/auto_test_1.mp4')\n# 如果需要测试，可以使用子片段\n# clip2 = VideoFileClip('test_videos/challenge.mp4').subclip(0,5)\n\n# 应用组合检测管道\nyellow_clip = clip2.fl_image(combined_detection_pipeline)\n\n# 写入视频文件\n%time yellow_clip.write_videofile(output_video, audio=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-16T23:57:15.788017Z","iopub.execute_input":"2025-04-16T23:57:15.788501Z","iopub.status.idle":"2025-04-17T00:01:52.972969Z","shell.execute_reply.started":"2025-04-16T23:57:15.788453Z","shell.execute_reply":"2025-04-17T00:01:52.971800Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"HTML(\"\"\"\n<video width=\"960\" height=\"500\" controls>\n  <source src=\"{0}\">\n</video>\n\"\"\".format(output_video))","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-17T00:01:52.974454Z","iopub.execute_input":"2025-04-17T00:01:52.975143Z","iopub.status.idle":"2025-04-17T00:01:52.982354Z","shell.execute_reply.started":"2025-04-17T00:01:52.975111Z","shell.execute_reply":"2025-04-17T00:01:52.981419Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"下面的这段代码能够较好的检测弯道车道线，但是直道车道线检测不出来。","metadata":{}},{"cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"import cv2\nimport numpy as np\n\ndef warp_perspective(img, src_pts, dst_pts):\n    src_pts = np.float32(src_pts)\n    dst_pts = np.float32(dst_pts)\n    M = cv2.getPerspectiveTransform(src_pts, dst_pts)\n    Minv = cv2.getPerspectiveTransform(dst_pts, src_pts)\n    warped = cv2.warpPerspective(img, M, (img.shape[1], img.shape[0]), flags=cv2.INTER_LINEAR)\n    return warped, M, Minv\n\ndef threshold_binary(img):\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    _, binary = cv2.threshold(gray, 160, 255, cv2.THRESH_BINARY)\n    return binary\n\ndef find_lane_pixels(binary_warped):\n    histogram = np.sum(binary_warped[binary_warped.shape[0]//2:, :], axis=0)\n    out_img = np.dstack((binary_warped, binary_warped, binary_warped)) * 255\n\n    midpoint = int(histogram.shape[0] // 2)\n    leftx_base = np.argmax(histogram[:midpoint])\n    rightx_base = np.argmax(histogram[midpoint:]) + midpoint\n\n    nwindows = 15  # 增加窗口数量\n    margin = 50  # 减小窗口宽度\n    minpix = 50\n\n    window_height = int(binary_warped.shape[0] // nwindows)\n    nonzero = binary_warped.nonzero()\n    nonzeroy = np.array(nonzero[0])\n    nonzerox = np.array(nonzero[1])\n\n    leftx_current = leftx_base\n    rightx_current = rightx_base\n\n    left_lane_inds = []\n    right_lane_inds = []\n\n    for window in range(nwindows):\n        win_y_low = binary_warped.shape[0] - (window + 1) * window_height\n        win_y_high = binary_warped.shape[0] - window * window_height\n\n        win_xleft_low = leftx_current - margin\n        win_xleft_high = leftx_current + margin\n\n        win_xright_low = rightx_current - margin\n        win_xright_high = rightx_current + margin\n\n        good_left_inds = ((nonzeroy >= win_y_low) & (nonzeroy < win_y_high) &\n                          (nonzerox >= win_xleft_low) & (nonzerox < win_xleft_high)).nonzero()[0]\n        good_right_inds = ((nonzeroy >= win_y_low) & (nonzeroy < win_y_high) &\n                           (nonzerox >= win_xright_low) & (nonzerox < win_xright_high)).nonzero()[0]\n\n        left_lane_inds.append(good_left_inds)\n        right_lane_inds.append(good_right_inds)\n\n        if len(good_left_inds) > minpix:\n            leftx_current = int(np.mean(nonzerox[good_left_inds]))\n        if len(good_right_inds) > minpix:\n            rightx_current = int(np.mean(nonzerox[good_right_inds]))\n\n    left_lane_inds = np.concatenate(left_lane_inds)\n    right_lane_inds = np.concatenate(right_lane_inds)\n\n    leftx = nonzerox[left_lane_inds]\n    lefty = nonzeroy[left_lane_inds]\n\n    rightx = nonzerox[right_lane_inds]\n    righty = nonzeroy[right_lane_inds]\n\n    return leftx, lefty, rightx, righty, nonzeroy, nonzerox, out_img, left_lane_inds, right_lane_inds\n\ndef fit_polynomial(binary_warped):\n    leftx, lefty, rightx, righty, nonzeroy, nonzerox, out_img, left_lane_inds, right_lane_inds = find_lane_pixels(binary_warped)\n    \n    if len(leftx) == 0 or len(rightx) == 0:\n        return out_img, None, None\n\n    left_fit = np.polyfit(lefty, leftx, 2)\n    right_fit = np.polyfit(righty, rightx, 2)\n\n    ploty = np.linspace(0, binary_warped.shape[0] - 1, binary_warped.shape[0])\n    try:\n        left_fitx = left_fit[0] * ploty ** 2 + left_fit[1] * ploty + left_fit[2]\n        right_fitx = right_fit[0] * ploty ** 2 + right_fit[1] * ploty + right_fit[2]\n    except TypeError:\n        left_fitx = 1 * ploty ** 2 + 1 * ploty\n        right_fitx = 1 * ploty ** 2 + 1 * ploty\n\n    # 使用 find_lane_pixels 函数返回的 left_lane_inds 和 right_lane_inds\n    out_img[nonzeroy[left_lane_inds], nonzerox[left_lane_inds]] = [255, 0, 0]\n    out_img[nonzeroy[right_lane_inds], nonzerox[right_lane_inds]] = [0, 0, 255]\n\n    return out_img, left_fit, right_fit\n\ndef draw_lane(original_img, binary_warped, left_fit, right_fit, Minv):\n    ploty = np.linspace(0, binary_warped.shape[0] - 1, binary_warped.shape[0])\n    color_warp = np.zeros_like(original_img).astype(np.uint8)\n\n    if left_fit is None or right_fit is None:\n        return original_img\n\n    left_fitx = left_fit[0] * ploty ** 2 + left_fit[1] * ploty + left_fit[2]\n    right_fitx = right_fit[0] * ploty ** 2 + right_fit[1] * ploty + right_fit[2]\n\n    pts_left = np.array([np.transpose(np.vstack([left_fitx, ploty]))])\n    pts_right = np.array([np.flipud(np.transpose(np.vstack([right_fitx, ploty])))])\n    pts = np.hstack((pts_left, pts_right))\n\n    cv2.fillPoly(color_warp, np.int_([pts]), (0, 255, 0))\n    newwarp = cv2.warpPerspective(color_warp, Minv, (original_img.shape[1], original_img.shape[0]))\n    result = cv2.addWeighted(original_img, 1, newwarp, 0.3, 0)\n    return result\n\ndef process_image(img):\n    try:\n        img_size = (img.shape[1], img.shape[0])\n\n        src = np.float32([[585, 460],\n                          [203, 720],\n                          [1127, 720],\n                          [695, 460]])\n        dst = np.float32([[320, 0],\n                          [320, 720],\n                          [960, 720],\n                          [960, 0]])\n\n        warped, M, Minv = warp_perspective(img, src, dst)\n        binary_warped = threshold_binary(warped)\n        out_img, left_fit, right_fit = fit_polynomial(binary_warped)\n        result = draw_lane(img, binary_warped, left_fit, right_fit, Minv)\n        return result\n    except Exception as e:\n        print(f\"Error in process_image: {e}\")\n        return img","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-04-17T02:44:46.562881Z","iopub.execute_input":"2025-04-17T02:44:46.563307Z","iopub
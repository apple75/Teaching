ages', 'val'),\n    ('images', 'test'),\n    ('labels', 'train'),\n    ('labels', 'val'),\n    ('labels', 'test')\n]\n\nfor subdir in subdirectories:\n    dir_path = merged_path / subdir[0] / subdir[1]\n    try:\n        os.makedirs(dir_path, exist_ok=True)\n        print(f\"成功创建子目录: {dir_path}\")\n    except Exception as e:\n        print(f\"创建子目录失败: {dir_path}，错误信息: {e}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2025-07-26T11:22:21.580387Z","iopub.execute_input":"2025-07-26T11:22:21.580780Z","iopub.status.idle":"2025-07-26T11:22:21.589235Z","shell.execute_reply.started":"2025-07-26T11:22:21.580748Z","shell.execute_reply":"2025-07-26T11:22:21.588223Z"}},"outputs":[{"name":"stdout","text":"merged_path 的绝对路径: /kaggle/working/merged-dataset\n成功创建目录: /kaggle/working/merged-dataset\n成功创建子目录: /kaggle/working/merged-dataset/images/train\n成功创建子目录: /kaggle/working/merged-dataset/images/val\n成功创建子目录: /kaggle/working/merged-dataset/images/test\n成功创建子目录: /kaggle/working/merged-dataset/labels/train\n成功创建子目录: /kaggle/working/merged-dataset/labels/val\n成功创建子目录: /kaggle/working/merged-dataset/labels/test\n","output_type":"stream"}],"execution_count":26},{"cell_type":"code","source":"# 类别映射\nclass_mapping = {\n    'car': 15,\n    'truck': 16,\n    'pedestrian': 17,\n    'bicyclist': 18\n}\n\n# 处理 self-driving-cars 数据集的训练集\nwith open(labels_train_csv, 'r') as f:\n    reader = csv.reader(f)\n    next(reader)  # 跳过标题行\n    for row in reader:\n        image_name = row[0]\n        class_name = row[1]\n        x_min = float(row[2])\n        y_min = float(row[3])\n        x_max = float(row[4])\n        y_max = float(row[5])\n        \n        if class_name not in class_mapping:\n            continue\n        \n        class_id = class_mapping[class_name]\n        \n        # 计算 YOLO 格式的边界框坐标\n        x_center = (x_min + x_max) / 2.0\n        y_center = (y_min + y_max) / 2.0\n        width = x_max - x_min\n        height = y_max - y_min\n        \n        # 创建 YOLO 格式
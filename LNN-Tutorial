        "    obs, info = env.reset()\n",
        "    ep = 0\n",
        "    ep_rewards = []\n",
        "    reward = 0\n",
        "    while ep < n_episodes:\n",
        "        if pertubation_level > 0.0:\n",
        "            obs = obs + np.random.default_rng().normal(0, pertubation_level, obs.shape)\n",
        "\n",
